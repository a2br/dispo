# SQLite locally (file:./data/dispo.db) or Turso in production (libsql://...)
DATABASE_URL="file:./data/dispo.db"
DATABASE_AUTH_TOKEN=""

# openssl rand -hex 32
AUTH_SECRET=""
# openssl rand -hex 32  (AES-256-GCM key for stored iCal URLs)
ICS_ENCRYPTION_KEY=""
# openssl rand -hex 16  (protects /api/cron/refresh)
CRON_SECRET=""

# Public origin, used for the OAuth redirect URI: $APP_URL/api/auth/callback
APP_URL="http://localhost:3000"

# Google OAuth client (Web application). Authorized redirect URI must match $APP_URL/api/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Set to 1 to enable /api/auth/dev?email=...@epfl.ch (never in production)
DEV_LOGIN=""

# Classmates discovery (Classes tab, /classmates, /course/*). Off unless set to 1.
FEATURE_CLASSMATES=""
